{
  "name": "riposte-social",
  "version": "0.1.0",
  "description": "A self-hosted social media sharing platform.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:social": "vite --config vite.social.config.js",
    "build": "npm run build:admin && npm run build:social",
    "build:admin": "vite build",
    "build:social": "vite build --config vite.social.config.js",
    "build:watch": "vite build --watch",
    "build:watch:social": "vite build --config vite.social.config.js --watch",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-translations.js",
    "lint": "eslint social-frontend",
    "lint:a11y": "eslint --rule '{ \"react/jsx-uses-vars\": \"off\", \"no-unused-vars\": \"off\" }' social-frontend",
    "a11y:smoke": "cypress run --spec cypress/e2e/a11y.cy.js",
    "a11y:smoke:strict": "A11Y_STRICTNESS=strict cypress run --spec cypress/e2e/a11y.cy.js",
    "a11y:smoke:docker": "docker run --rm --network=host -v \"$PWD\":/e2e -w /e2e cypress/included:15.14.2 cypress run --spec cypress/e2e/a11y.cy.js",
    "a11y:smoke:strict:docker": "docker run --rm --network=host -e A11Y_STRICTNESS=strict -v \"$PWD\":/e2e -w /e2e cypress/included:15.14.2 cypress run --spec cypress/e2e/a11y.cy.js"
  },
  "keywords": [],
  "author": "Grant DeFayette <grant@cavebatsofware.com>",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.8",
    "@xterm/xterm": "^5.5.0",
    "apexcharts": "^5.3.6",
    "dompurify": "^3.4.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "marked": "^18.0.2",
    "react": "^19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.11.4",
    "cypress": "^15.5.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "vite": "^7.1.10",
    "vite-plugin-compression": "^0.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social.cavebatsofware.com/riposte-social.git"
  },
  "bugs": {
    "url": "https://github.com/social.cavebatsofware.com/riposte-social/issues"
  },
  "homepage": "https://github.com/social.cavebatsofware.com/riposte-social#readme"
}
