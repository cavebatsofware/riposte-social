# Rust build files
/target/
**/*.rs.bk

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# macOS system files
.DS_Store

# Logs
*.log

# Byebug command history file.
.byebug_history

# Node modules (if using frontend)
node_modules/

# Admin frontend build artifacts
assets/admin/
social-assets/
admin-frontend/dist/

# Coverage
coverage/
*.profraw

# Misc
*.tmp
*.bak
*.pdf
.env

# Operator deployment config lives in a separate private repo (../riposte-deploy),
# symlinked into ./deploy here. Never tracked in the product.
/deploy
.github/tokens


# Database
backups/
*.sql
*.dump

# Docker
docker-compose.override.yml

admin-assets/

# Business storefront static export (staged before the business image build);
# keep the directory present for the Dockerfile COPY, ignore the built files.
shop-assets/*
!shop-assets/.gitkeep

# Public frontend build artifacts
public-assets/
public-frontend/dist/
public-frontend/node_modules/

# Crates
crates/

# Cypress run artifacts (only produced when CYPRESS_SCREENSHOTS=true
# or CYPRESS_VIDEO=true is set; the default config skips both)
cypress/screenshots/
cypress/videos/
cypress/downloads/
