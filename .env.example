# riposte-social Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================

# Port the server listens on (default: 3000)
PORT=3000

# Site domain (used for email validation and display)
SITE_DOMAIN=yourdomain.com

# Site URL (used for email verification links and landing page)
SITE_URL=https://yourdomain.com

# Development mode: uses socket address for IP extraction instead of
# X-Forwarded-For header. Set to "true" for local dev without a reverse proxy.
DEV_MODE=false

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection details
POSTGRES_DB=riposte_social
POSTGRES_USER=riposte_social_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Database host (use 'localhost' for local dev, 'postgres' for Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Full connection URL (must match the POSTGRES_* vars above)
DATABASE_URL=postgresql://riposte_social_user:changeme@localhost:5432/riposte_social

# Test database (uses port 5433 to avoid conflicts)
TEST_POSTGRES_USER=riposte_social_test_user
TEST_POSTGRES_PASSWORD=test_password
TEST_POSTGRES_DB=riposte_social_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://riposte_social_test_user:test_password@localhost:5433/riposte_social_test

# Set to "true" and run with 'cargo run -- migrate' to run migrations
MIGRATE_DB=false

# =============================================================================
# Security Configuration
# =============================================================================

# General rate limiting - max requests per minute before blocking IP (default: 120).
# This limit is per-instance. In a single-instance self-hosted deployment it is
# the primary abuse defense. In a multi-instance deployment, abuse prevention
# belongs at the load balancer or proxy layer; this setting acts as a local
# circuit breaker to keep any one instance responsive under concentrated load.
RATE_LIMIT_PER_MINUTE=120

# How long to block IPs that exceed the general rate limit, in minutes (default: 15)
BLOCK_DURATION_MINUTES=15

# Grace period in seconds before the bucket starts charging requests after a
# burst. Lets a fresh client land a few requests before consumption begins.
# (default: 1)
RATE_LIMIT_GRACE_PERIOD_SECONDS=1

# Cache refund ratio for HTTP 304 NOT_MODIFIED responses (cache hits where
# the client sent If-None-Match and the resource hadn't changed). 0.75 means
# the bucket gets back 75% of the consumed token; a feed re-poll that hits
# the browser cache costs only 0.25 net tokens regardless of auth status,
# since no server-side data is fetched. Range: 0.0 (no refund) to 1.0
# (304s are free). (default: 0.75)
RATE_LIMIT_CACHE_REFUND_RATIO=0.75

# Token refund for authenticated requests. On non-304, non-error responses,
# 50% of the base token cost is refunded, so authenticated users get 2x the
# effective request capacity of anonymous users. On 304 responses the cache
# refund applies instead (the two never stack). The auth endpoint rate
# limiter is unaffected. Range: 0.0 (no refund) to 1.0 (authenticated
# requests are free). (default: 0.5)
RATE_LIMIT_AUTH_REFUND_RATIO=0.5

# Extra tokens charged for error (4xx/5xx) responses, on top of the base
# cost. 2.0 means a 4xx costs 3 tokens (1 base + 2 penalty). Aggressive
# on abuse (404 probing depletes the bucket fast), forgiving on success.
# (default: 2.0)
RATE_LIMIT_ERROR_PENALTY=2.0

# Auth endpoint rate limiting - stricter limits for login/register/MFA (default: 5)
AUTH_RATE_LIMIT_PER_MINUTE=5

# How long to block IPs that exceed the auth rate limit, in minutes (default: 30)
AUTH_BLOCK_DURATION_MINUTES=30

# Auth bucket grace period in seconds. Default 0 (no grace) since brute-force
# attempts should consume tokens immediately.
AUTH_RATE_LIMIT_GRACE_PERIOD_SECONDS=0

# Auth bucket cache refund. Default 0.0 (no refund) since auth requests are
# stateful and should always cost their full token. (default: 0.0)
AUTH_RATE_LIMIT_CACHE_REFUND_RATIO=0.0

# Auth error penalty - failed login costs much more than a successful one
# so brute-force gets blocked faster. 4.0 means a 401 costs 5 tokens (1+4),
# so 5-req/min bucket blocks after one failed attempt. (default: 4.0)
AUTH_RATE_LIMIT_ERROR_PENALTY=4.0

# AES-256 key for encrypted-at-rest values: TOTP secrets, single-use
# tokens, and `settings` rows marked encrypted. Generate with:
# openssl rand -hex 32
# The server wipes this var from its own process environment after
# startup so it can't be read back via `env`-dumping logs, crash-time
# /proc/self/environ, or inherited child processes.
SECURE_VALUES_KEY=

# =============================================================================
# Access Logging
# =============================================================================

# Enable/disable access logging to database
ENABLE_ACCESS_LOGGING=true

# Log successful attempts (set false to reduce database writes)
LOG_SUCCESSFUL_ATTEMPTS=true

# How many days to retain access logs before automatic cleanup (default: 1)
ACCESS_LOG_RETENTION_DAYS=1

# =============================================================================
# Site Settings (initial seed values)
# =============================================================================
# These values seed the database settings table on first migration.
# After that, the Admin Settings UI is the source of truth.
# Fallback chain: DB value -> env var -> hardcoded default.

# Site name displayed in emails and pages (default: "riposte-social")
SITE_NAME=riposte-social

# Contact email for form submissions (default: "contact@example.com")
CONTACT_EMAIL=contact@yourdomain.com

# =============================================================================
# AWS Configuration (for SES email and S3 storage)
# =============================================================================

# S3 bucket for document storage
S3_BUCKET_NAME=your-bucket-name

# S3-compatible endpoint URL (optional - for OCI Object Storage, MinIO, etc.)
# When not set, uses standard AWS S3 endpoints
# Example for OCI: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Example for MinIO: http://localhost:9000
S3_ENDPOINT_URL=

# S3 region override (optional - overrides AWS_REGION for S3 only)
S3_REGION=

# Force path-style S3 addressing (set to "true" for OCI/MinIO compatibility)
S3_FORCE_PATH_STYLE=false

# SES sender email address (also seeds the "from_email" DB setting on first migration)
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Docker/ECR Deployment (optional - only needed for ECR deployment)
# =============================================================================

# ECR registry URL: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY_URL=

# ECR repository name
ECR_REPO_NAME=

# AWS region (default: us-east-2)
ECR_REGION=us-east-2

# =============================================================================
# OCI Container Registry (OCIR) Deployment (optional - only needed for OCIR deployment)
# =============================================================================

# OCIR registry URL: <region>.ocir.io/<tenancy-namespace>
OCIR_REGISTRY_URL=

# OCIR repository name
OCIR_REPO_NAME=

# OCIR region (default: us-ashburn-1)
OCIR_REGION_NAME=us-ashburn-1

# OCIR login credentials
# Username format: <tenancy-namespace>/<username> or <tenancy-namespace>/oracleidentitycloudservice/<username>
OCIR_USERNAME=

# OCIR auth token (generate from OCI Console -> User Settings -> Auth Tokens)
OCIR_AUTH_TOKEN=

# =============================================================================
# OIDC Authentication (optional - for Keycloak SSO integration)
# =============================================================================

# Enable OIDC authentication (disables local password auth when true)
OIDC_ENABLED=false

# OIDC provider issuer URL (e.g., https://keycloak.example.com/realms/myrealm)
OIDC_ISSUER_URL=

# OIDC client credentials
OIDC_CLIENT_ID=headscale
OIDC_CLIENT_SECRET=

# Redirect URI (must match the OIDC provider configuration)
# e.g., https://yourdomain.com/api/auth/oidc/callback
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# Scopes to request (space-separated)
OIDC_SCOPES=openid profile email

# Claim path for extracting roles from ID token (dot-separated for nested claims)
OIDC_ROLE_CLAIM=realm_access.roles

# Role name in the OIDC provider that maps to application administrator
OIDC_ADMIN_ROLE=admin

# =============================================================================
# Custom Public Frontend (optional)
# =============================================================================

# Path to an external Astro site to use instead of the built-in fallback.
# The site must have `npm run build` and output to `dist/`.
# Leave empty to serve static files from public-assets/ (if present).
PUBLIC_FRONTEND_PATH=
